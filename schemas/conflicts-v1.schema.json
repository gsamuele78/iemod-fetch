{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gsamuele78/iemod-fetch/schemas/conflicts-v1.schema.json",
  "title": "iemod-fetch conflict report, version 1",
  "description": "--conflict-report: component-level findings, each with a stable id. iemod_fetch/conflicts.py is the authority.",
  "type": "object",
  "required": ["schema_version", "rules_checked", "findings"],
  "properties": {
    "schema_version": {"const": 1},
    "rules_checked": {"type": "integer"},
    "findings": {"type": "array", "items": {
      "type": "object",
      "required": ["id", "kind", "severity", "log", "scope", "left", "right", "remedy"],
      "properties": {
        "id": {"type": "string", "pattern": "^conflict-[0-9a-f]{16}$"},
        "kind": {"type": "string"},
        "severity": {"type": "string"},
        "log": {"type": "string"},
        "scope": {"enum": ["cross-mod", "same-mod", "missing"]},
        "left": {"$ref": "#/$defs/side"},
        "right": {"anyOf": [{"$ref": "#/$defs/side"}, {"type": "null"}]},
        "remedy": {"type": "string"},
        "order_fixable": {"type": "boolean"},
        "fixed_by_plan": {"type": ["boolean", "null"]}
      }}}
  },
  "$defs": {
    "side": {"type": "object", "required": ["mod", "components", "whole_mod"],
             "properties": {"mod": {"type": "string"},
                            "components": {"type": "array", "items": {"type": "integer"}},
                            "whole_mod": {"type": "boolean"}}}
  }
}
